# Copiar como .env.local (nunca commitear el real — ver .gitignore).
# NEXT_PUBLIC_*: expuesta al navegador, nunca poner acá un secreto.

# Base URL del backend (ver src/config/env.js del backend, PORT=3000 por
# defecto en desarrollo local). Esta variable queda incrustada en el
# bundle del navegador — para probar la app desde un celular en la
# misma red WiFi que el computador, "localhost" no sirve (en el
# celular se referiría a sí mismo, no al computador): cambiarla acá a
# la IP de red local del computador, con el mismo puerto del backend,
# ej. http://192.168.1.23:3000. El backend también necesita aceptar ese
# origen — ver CORS_ORIGIN en el .env.example de la raíz del repo.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
