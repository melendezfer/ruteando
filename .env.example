# Copiar como .env.development / .env.staging / .env.production
# Nunca commitear los archivos .env reales (ver .gitignore).

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres + PostGIS. Debe apuntar a una base con `CREATE EXTENSION postgis;`
# ya aplicada y con schema.sql (o las migraciones de /migrations) ejecutadas.
DATABASE_URL=postgres://usuario:password@localhost:5432/ruteando_dev

# JWT — access token de corta duración + refresh token rotativo (regla de
# seguridad #9, RFC 9700). Generar secretos distintos por ambiente, nunca
# reusar el mismo valor entre development/staging/production.
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Almacenamiento de fotos, compatible con S3 (Cloudflare R2 o Backblaze B2).
S3_ENDPOINT=https://changeme.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ruteando-media-dev
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
