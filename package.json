{
  "name": "ruteando",
  "version": "1.0.0",
  "description": "API de RUTEANDO: geolocalización de vendedores gastronómicos informales en Ciudad Verde, Soacha.",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "NODE_ENV=development jest --runInBand",
    "test:unit": "NODE_ENV=development jest --runInBand tests/unit",
    "test:integration": "NODE_ENV=development jest --runInBand tests/integration",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "seed:loadtest": "node scripts/seedLoadTest.js",
    "seed:loadtest:clean": "node scripts/seedLoadTest.js --clean",
    "loadtest": "k6 run scripts/loadtest-nearby.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melendezfer/ruteando.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/melendezfer/ruteando/issues"
  },
  "homepage": "https://github.com/melendezfer/ruteando#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
