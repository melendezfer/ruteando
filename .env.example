# Copiar como .env.development / .env.staging / .env.production
# Nunca commitear los archivos .env reales (ver .gitignore).
#
# Nombres y descripciones: Documento 14, sección 1.4 (variables de entorno
# reales) — no agregar variables aquí sin actualizar ese documento primero.

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://usuario:clave@host:5432/basededatos

# Comportamiento del servidor
NODE_ENV=development

# Puerto donde escucha la API
PORT=3000

# Firma de tokens de acceso (15 min, valor fijo — ver src/config/constants.js)
JWT_ACCESS_SECRET=cadena-aleatoria-larga

# Firma de refresh tokens rotativos (30 días, valor fijo). DISTINTA a
# JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=otra-cadena-aleatoria-larga-y-distinta

# Subida de fotos (RF-007) — endpoint de la API S3 del proveedor
# (Cloudflare R2 o Backblaze B2), donde el SDK firma PUT/DELETE. NO sirve
# lectura pública anónima de los objetos.
STORAGE_ENDPOINT=https://changeme.r2.cloudflarestorage.com
STORAGE_BUCKET=ruteando-media
STORAGE_ACCESS_KEY=changeme
STORAGE_SECRET_KEY=changeme

# Base de lectura pública real de las fotos (bucket público de R2, dominio
# custom, o el CDN delante de B2) — distinta de STORAGE_ENDPOINT.
# Obligatoria en production; si se omite en dev/staging, se usa
# STORAGE_ENDPOINT como respaldo (correcto solo cuando ese endpoint sí es
# alcanzable por el cliente, como MinIO en desarrollo local).
STORAGE_PUBLIC_URL=https://pub-changeme.r2.dev

# Registro de errores centralizado. Obligatorio en production.
SENTRY_DSN=

# Confirmación de disponibilidad en tiempo real — Firebase Cloud Messaging
# para el push real al dispositivo (no hay proveedor conectado hoy).
# Credenciales de la cuenta de servicio (Firebase Console > Project
# Settings > Service Accounts > Generate new private key). Obligatorias en
# production; en development/staging, si se omiten, el envío de push se
# degrada a un no-op logueado (ver src/config/firebaseClient.js), igual
# que el envío de correo de RF-003 sin proveedor elegido todavía.
# FIREBASE_PRIVATE_KEY: el JSON que exporta Firebase trae saltos de línea
# reales — al pegarla en una sola línea de .env hay que escaparlos como
# "\n" literal (el código los revierte con .replace(/\\n/g, '\n')).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Restringe qué origen puede llamar a la API
CORS_ORIGIN=https://app.ruteando.co

# Intentos de login antes de bloqueo progresivo
RATE_LIMIT_LOGIN_MAX=5
