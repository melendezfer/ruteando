# Copiar como .env.development / .env.staging / .env.production
# Nunca commitear los archivos .env reales (ver .gitignore).
#
# Nombres y descripciones: Documento 14, sección 1.4 (variables de entorno
# reales) — no agregar variables aquí sin actualizar ese documento primero.

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://usuario:clave@host:5432/basededatos

# Comportamiento del servidor
NODE_ENV=development

# Puerto donde escucha la API
PORT=3000

# Firma de tokens de acceso (15 min, valor fijo — ver src/config/constants.js)
JWT_ACCESS_SECRET=cadena-aleatoria-larga

# Firma de refresh tokens rotativos (30 días, valor fijo). DISTINTA a
# JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=otra-cadena-aleatoria-larga-y-distinta

# Subida/lectura de fotos (RF-007) — según el proveedor (Cloudflare R2 o
# Backblaze B2)
STORAGE_ENDPOINT=https://changeme.r2.cloudflarestorage.com
STORAGE_BUCKET=ruteando-media
STORAGE_ACCESS_KEY=changeme
STORAGE_SECRET_KEY=changeme

# Registro de errores centralizado. Obligatorio en production.
SENTRY_DSN=

# Restringe qué origen puede llamar a la API
CORS_ORIGIN=https://app.ruteando.co

# Intentos de login antes de bloqueo progresivo
RATE_LIMIT_LOGIN_MAX=5
